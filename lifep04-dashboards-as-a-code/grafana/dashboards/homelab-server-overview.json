{
  "id": null,
  "uid": "homelab-server-overview",
  "title": "Home Lab: Server & Plex Overview",
  "description": "Host health (CPU/memory/disk) and Plex streaming activity for a 24/7 Windows home server.",
  "tags": ["homelab", "plex", "windows", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "row", "title": "Host Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2, "type": "stat", "title": "CPU Usage",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 - (avg(rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] }
        }
      },
      "options": { "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 3, "type": "gauge", "title": "Memory Used",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "(1 - (windows_memory_available_bytes / windows_cs_physical_memory_bytes)) * 100", "legendFormat": "Mem %" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] }
        }
      }
    },
    {
      "id": 4, "type": "stat", "title": "Free Disk (Media Volume)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "windows_logical_disk_free_bytes{volume=\"D:\"}", "legendFormat": "Free" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5, "type": "stat", "title": "Active Plex Streams",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(plex_active_streams)", "legendFormat": "Streams" }],
      "fieldConfig": { "defaults": { "unit": "none" } },
      "options": { "colorMode": "background" }
    },
    {
      "id": 6, "type": "timeseries", "title": "CPU & Memory (24h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 - (avg(rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %" },
        { "expr": "(1 - (windows_memory_available_bytes / windows_cs_physical_memory_bytes)) * 100", "legendFormat": "Mem %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Disk Free Space by Volume",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "windows_logical_disk_free_bytes", "legendFormat": "{{volume}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 8, "type": "row", "title": "Plex", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 9, "type": "timeseries", "title": "Concurrent Streams (24h)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(plex_active_streams) by (transcode_decision)", "legendFormat": "{{transcode_decision}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } },
      "description": "Requires a Plex Prometheus exporter (e.g. jsavargas/plex_exporter or similar community exporter) polling your Plex server's /status/sessions endpoint."
    }
  ]
}
